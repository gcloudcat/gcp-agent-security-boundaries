# Copy this file to .env (`cp .env.example .env`), fill in your own GCP identifiers,
# and run `source .env` before executing the gcloud commands in README.md.

export ORG_ID="123456789012"
export BILLING_ID="012345-6789AB-CDEF01"
export ACCESS_POLICY_ID="987654321098"
export PROJECT_ID="enterprise-agent-prod"
export PROJECT_NUMBER="112233445566"
export REGION="us-central1"
export KEYRING_NAME="agent-security-keyring"
export KEY_NAME="agent-cmek"
export KEY_VERSION="1"
export AUTHORIZED_USER="developer@example.com"

# ADK / Agent Runtime environment variables for running `adk web` or `adk run agent`
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"
export GOOGLE_CLOUD_PROJECT="${PROJECT_ID}"
export GOOGLE_CLOUD_PROJECT_NUMBER="${PROJECT_NUMBER}"
export GOOGLE_CLOUD_ORG_ID="${ORG_ID}"
export GOOGLE_CLOUD_LOCATION="${REGION}"
export VAULT_BUCKET="enterprise-agent-vault"
export EXTERNAL_BUCKET="external-project-bucket"
export VAULT_OBJECT_NAME="confidential-record.txt"
